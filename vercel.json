{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "tanstack-start",
      "installCommand": "cd ../.. && pnpm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "https://yapper-server-amri.interceptorghost4.workers.dev/api/auth/$1"
    },
    {
      "source": "/trpc/(.*)",
      "destination": "https://yapper-server-amri.interceptorghost4.workers.dev/trpc/$1"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
